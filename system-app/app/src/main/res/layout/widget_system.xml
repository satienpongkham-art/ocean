<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center" android:orientation="vertical" android:padding="10dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◆ SYSTEM"
        android:textColor="#FF4FD8FF" android:textSize="11sp" android:letterSpacing="0.2" android:textStyle="bold" />
    <TextView android:id="@+id/w_level" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LV 1"
        android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_core" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CORE 0/6"
        android:textColor="#FFFF6B7F" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
        android:textColor="#FF9EC3DA" android:textSize="11sp" />
</LinearLayout>
